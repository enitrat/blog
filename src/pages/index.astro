---
import '../styles/home.css';

import type { ImageMetadata } from 'astro';
import stageBuilder from '../assets/home/stage-builder.webp';
import workLanguage from '../assets/home/work-language.webp';
import workSystems from '../assets/home/work-systems.webp';
import writingIdeas from '../assets/home/writing-ideas.webp';
import ArrowIcon from '../components/ArrowIcon.astro';
import ContactLinks from '../components/ContactLinks.astro';
import LivingIndex, { type LivingIndexItem } from '../components/home/LivingIndex.astro';
import { SITE_DESCRIPTION } from '../consts';
import Page from '../layouts/Page.astro';
import { getWorkIndex, workUrl } from '../utils/work';
import { getWritingIndex, postUrl } from '../utils/writing';

// Three writing entries against three work entries, so the two channels of
// the index end at the same rule.
const recentPosts = (await getWritingIndex()).slice(0, 3);
const reports = await getWorkIndex();

const workArt: Record<string, ImageMetadata> = {
	kakarot: stageBuilder,
	'starknet-agent': workSystems,
	'cairo-coder': workLanguage,
};

const work: LivingIndexItem[] = reports.map((report) => ({
	id: `work-${report.id}`,
	title: report.data.title,
	href: workUrl(report),
	description: report.data.summary,
	art: workArt[report.id] ?? stageBuilder,
}));

const writingArt = [writingIdeas, workLanguage, workSystems, stageBuilder];
const writing: LivingIndexItem[] = recentPosts.map((post, index) => ({
	id: `writing-${post.id.replaceAll('/', '-')}`,
	title: post.data.title,
	href: postUrl(post),
	description: post.data.description,
	art: writingArt[index % writingArt.length],
}));
---

<Page title="Mathieu Saugé" description={SITE_DESCRIPTION}>
	<LivingIndex work={work} writing={writing} />

	<section class="home-close" id="contact" aria-label="Say hello">
		<div>
			<p class="home-close__invitation">
				If you've enjoyed reading about me and anything resonates, whether an essay, a project
				I've built, or a book we've both read, send me a message and say hello!
			</p>

			<nav class="home-close__portals" aria-label="Elsewhere on this site">
				<a href="/about">
					<span class="label">Who writes this</span>
					<strong>About</strong>
					<ArrowIcon />
				</a>
				<a href="/bookshelf">
					<span class="label">What I read</span>
					<strong>Bookshelf</strong>
					<ArrowIcon />
				</a>
				<a href="/writing">
					<span class="label">Everything written</span>
					<strong>Writing</strong>
					<ArrowIcon />
				</a>
			</nav>

			<ContactLinks variant="chips" />
		</div>
	</section>
</Page>
