---
import '../styles/home.css';

import PersonalIndex from '../components/home/PersonalIndex.astro';
import { SITE_DESCRIPTION } from '../consts';
import Page from '../layouts/Page.astro';
import { getWorkIndex, workUrl } from '../utils/work';
import { getWritingIndex, postUrl } from '../utils/writing';

const recentPosts = (await getWritingIndex()).slice(0, 3);
const reports = await getWorkIndex();

const toItem = (report: (typeof reports)[number]) => ({
	id: `work-${report.id}`,
	title: report.data.title,
	href: workUrl(report),
	description: report.data.summary,
});

const work = reports.filter((report) => report.data.kind === 'work').map(toItem);
const projects = reports.filter((report) => report.data.kind === 'project').map(toItem);

const writing = recentPosts.map((post) => ({
	id: `writing-${post.id.replaceAll('/', '-')}`,
	title: post.data.title,
	href: postUrl(post),
	description: post.data.description,
}));
---

<Page title="Mathieu Saugier" description={SITE_DESCRIPTION}>
	<PersonalIndex work={work} projects={projects} writing={writing} />
</Page>
