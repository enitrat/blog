---
import { type Book, type BookStatus, books } from '../../booksData';
import Page from '../../layouts/Page.astro';

const groups: { key: BookStatus; label: string }[] = [
	{ key: 'reading', label: 'Reading now' },
	{ key: 'finished', label: 'Finished' },
	{ key: 'want-to-read', label: 'Want to read' },
];

const dateOf = (book: Book) => book.dateFinished ?? book.dateStarted;

const shelves = groups
	.map((group) => ({
		...group,
		books: books
			.filter((book) => book.status === group.key)
			.sort((a, b) => (dateOf(b)?.valueOf() ?? 0) - (dateOf(a)?.valueOf() ?? 0)),
	}))
	.filter((shelf) => shelf.books.length > 0);

const formatYear = (date: Date | null) => (date ? String(date.getFullYear()) : '—');
---

<Page
	title="Bookshelf — Mathieu Saugier"
	description="A reading archive: what Mathieu Saugier is reading, has read, and means to read."
>
	<header class="page-head">
		<h1>Bookshelf</h1>
		<p>What I read.</p>
	</header>

	{shelves.map((shelf) => (
		<section class="shelf" aria-labelledby={`shelf-${shelf.key}`}>
			<div class="shelf__heading">
				<h2 id={`shelf-${shelf.key}`}>{shelf.label}</h2>
				<span>{shelf.books.length} {shelf.books.length === 1 ? 'book' : 'books'}</span>
			</div>
			<ul class="shelf__list">
				{shelf.books.map((book) => (
					<li>
						<span class="shelf__year">{formatYear(dateOf(book))}</span>
						<div class="shelf__title">
							<h3>
								{book.writingSlug
									? <a href={`/writing/${book.writingSlug}/`}>{book.title}</a>
									: book.title}
							</h3>
							<p>{book.author}</p>
						</div>
						<span class="shelf__rating">
							{book.rating ? book.rating.toFixed(1) : <span class="shelf__unrated">—</span>}
							<span class="sr-only">{book.rating ? ` out of 5` : 'Not rated'}</span>
						</span>
					</li>
				))}
			</ul>
		</section>
	))}

	<nav class="shelf__onward" aria-label="Continue">
		<a href="/writing">Writing</a>
		<a href="/about">About</a>
	</nav>
</Page>

<style>
	.shelf {
		padding-top: clamp(2rem, 3.5vw, 3rem);
	}

	.shelf__onward {
		display: flex;
		gap: clamp(1.5rem, 4vw, 3rem);
		max-width: var(--home-row-max);
		margin-top: clamp(2rem, 3.5vw, 3rem);
		padding: clamp(1.1rem, 2.2vw, 1.7rem) 0 clamp(4rem, 8vw, 7rem);
		border-top: 1px solid var(--home-ink);
		color: var(--home-cobalt);
		font-size: 0.78rem;
		font-weight: 650;
	}

	.shelf__heading {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 1.1rem;
	}

	.shelf__heading h2 {
		margin: 0;
		font-family: var(--home-display);
		font-size: clamp(1.6rem, 2.6vw, 2.3rem);
		font-weight: 560;
		letter-spacing: -0.03em;
	}

	.shelf__heading span {
		color: var(--home-cobalt);
		font-size: 0.65rem;
		font-weight: 680;
		letter-spacing: 0.07em;
	}

	.shelf__list {
		max-width: var(--home-row-max);
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--home-ink);
	}

	.shelf__list li {
		display: grid;
		grid-template-columns: 5rem minmax(0, 1fr) 3rem;
		align-items: baseline;
		gap: clamp(1rem, 3vw, 3rem);
		padding: clamp(1.1rem, 2.2vw, 1.7rem) 0;
		border-bottom: 1px solid var(--home-rule);
	}

	.shelf__year {
		color: var(--home-cobalt);
		font-size: 0.7rem;
		font-weight: 620;
		letter-spacing: 0.04em;
	}

	.shelf__title h3 {
		margin: 0;
		font-family: var(--home-display);
		font-size: clamp(1.15rem, 1.9vw, 1.5rem);
		font-weight: 550;
		line-height: 1.16;
		letter-spacing: -0.02em;
	}

	/* Deliberate exception to "cobalt means clickable": a shelf title rests in
	   ink and only reveals its link on hover. */
	.shelf__title h3 a:hover {
		color: var(--home-cobalt);
	}

	.shelf__title p {
		margin: 0.3rem 0 0;
		color: var(--home-muted);
		font-size: 0.78rem;
	}

	.shelf__rating {
		color: var(--home-cobalt);
		font-size: 0.82rem;
		font-weight: 620;
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	.shelf__unrated {
		color: var(--home-muted);
	}

	@media (max-width: 760px) {
		.shelf__list li {
			grid-template-columns: minmax(0, 1fr) 3rem;
			gap: 0.5rem 1rem;
		}

		.shelf__year {
			grid-column: 1 / -1;
		}
	}
</style>
