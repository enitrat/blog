---
import ArrowIcon from '../components/ArrowIcon.astro';
import Page from '../layouts/Page.astro';

const destinations = [
	{ href: '/', meta: 'Home', title: 'Mathieu Saugier' },
	{ href: '/work', meta: 'Work', title: 'What I have worked on' },
	{ href: '/writing', meta: 'Writing', title: 'Writing' },
	{ href: '/about', meta: 'About', title: 'About' },
];
---

<Page title="Not found" description="This page does not exist.">
	<div class="measure">
		<header class="page-head">
			<h1>Not found</h1>
			<p>This address doesn't name anything here. Try one of these four pages:</p>
		</header>

		<div class="writing-ledger">
			{destinations.map((destination) => (
				<article>
					<a class="writing-ledger__row" href={destination.href}>
						<span class="writing-ledger__meta">{destination.meta}</span>
						<div>
							<h2>{destination.title}</h2>
						</div>
						<span class="writing-ledger__arrow" aria-hidden="true">
							<ArrowIcon />
						</span>
					</a>
				</article>
			))}
		</div>
	</div>
</Page>

<style>
	.writing-ledger {
		margin-top: clamp(2rem, 3.5vw, 3rem);
		padding-bottom: clamp(4rem, 8vw, 7rem);
		border-top: 0;
	}

	/* The rows are h2 under the page's h1; keep the shared ledger title look. */
	.writing-ledger h2 {
		margin: 0;
		font-family: var(--home-sans);
		font-size: var(--type-title-ledger-size);
		font-weight: var(--type-title-ledger-weight);
		line-height: var(--type-title-ledger-leading);
		letter-spacing: var(--type-title-ledger-tracking);
	}

	.writing-ledger__row:hover h2,
	.writing-ledger__row:focus-visible h2 {
		color: var(--home-cobalt);
	}
</style>
