---
import ArrowIcon from '../../components/ArrowIcon.astro';
import Page from '../../layouts/Page.astro';
import { getWorkIndex, workUrl } from '../../utils/work';

const reports = await getWorkIndex();

// Same two groups as the homepage index: employment, then things built
// alongside it.
const groups = [
	{ key: 'work', label: 'Work', reports: reports.filter((r) => r.data.kind === 'work') },
	{ key: 'project', label: 'Projects', reports: reports.filter((r) => r.data.kind === 'project') },
].filter((group) => group.reports.length > 0);
---

<Page
	title="Work — Mathieu Saugier"
	description="Field reports from the projects Mathieu Saugier has built and led."
>
	<header class="page-head">
		<h1>Work</h1>
		<p>Things I've worked on.</p>
	</header>

	{groups.map((group) => (
		<section class="group" aria-labelledby={`group-${group.key}`}>
			<h2 class="label" id={`group-${group.key}`}>{group.label}</h2>
			<div class="writing-ledger">
				{group.reports.map((report) => (
					<article>
						<span class="writing-ledger__meta">
							{[report.data.role, report.data.period].filter(Boolean).join(' · ') || 'Field report'}
						</span>
						<div>
							<h3><a href={workUrl(report)}>{report.data.title}</a></h3>
							<p>{report.data.summary}</p>
						</div>
						<a class="writing-ledger__arrow" href={workUrl(report)} aria-label={`Read the ${report.data.title} field report`}>
							<ArrowIcon />
						</a>
					</article>
				))}
			</div>
		</section>
	))}
</Page>

<style>
	.group {
		padding-top: clamp(2rem, 3.5vw, 3rem);
	}

	.group:last-of-type {
		padding-bottom: clamp(4rem, 8vw, 7rem);
	}

	.group h2 {
		margin: 0 0 1.1rem;
		font-family: var(--home-sans);
	}
</style>
