---
import ArrowIcon from '../../components/ArrowIcon.astro';
import Page from '../../layouts/Page.astro';
import { getWorkIndex, workUrl } from '../../utils/work';

const reports = await getWorkIndex();

// Same two groups as the homepage index: employment, then things built
// alongside it. Each heading id doubles as the fragment the homepage index
// links to, so `/work/#projects` lands on the group it names.
const groups = [
	{ id: 'work', label: 'Work', reports: reports.filter((r) => r.data.kind === 'work') },
	{ id: 'projects', label: 'Projects', reports: reports.filter((r) => r.data.kind === 'project') },
].filter((group) => group.reports.length > 0);
---

<Page
	title="Work — Mathieu Saugier"
	description="Field reports from the projects Mathieu Saugier has built and led."
>
	<div class="measure">
		<header class="page-head">
			<h1>Work</h1>
		</header>

		{groups.map((group) => (
			<section class="group" aria-labelledby={group.id}>
				<h2 class="label" id={group.id}>{group.label}</h2>
				<div class="writing-ledger">
					{group.reports.map((report) => (
						<article>
							<a class="writing-ledger__row" href={workUrl(report)}>
								<span class="writing-ledger__meta">
									{[report.data.role, report.data.period].filter(Boolean).join(' · ') || 'Field report'}
								</span>
								<div>
									<h3>{report.data.title}</h3>
									<p>{report.data.summary}</p>
								</div>
								<span class="writing-ledger__arrow" aria-hidden="true">
									<ArrowIcon />
								</span>
							</a>
						</article>
					))}
				</div>
			</section>
		))}
	</div>
</Page>

<style>
	.group {
		padding-top: clamp(2rem, 3.5vw, 3rem);
	}

	.group:last-of-type {
		padding-bottom: clamp(4rem, 8vw, 7rem);
	}

	.group h2 {
		margin: 0 0 1.1rem;
		font-family: var(--home-sans);
	}
</style>
