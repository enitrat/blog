---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

// Find translations: posts in the same directory (same base slug)
const allPosts = await getCollection('blog');
const baseSlug = post.id.split('/')[0];
const translations = allPosts
	.filter((p) => p.id.split('/')[0] === baseSlug && p.id !== post.id)
	.map((p) => ({ lang: p.data.lang, slug: p.id, title: p.data.title }));

// Adjacent essays in this post's own language, newest first, so the article
// offers a way onward rather than only a way back.
const siblings = allPosts
	.filter((p) => (p.data.lang ?? 'en') === (post.data.lang ?? 'en'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const index = siblings.findIndex((p) => p.id === post.id);
const toLink = (entry: (typeof siblings)[number] | undefined) =>
	entry ? { slug: entry.id, title: entry.data.title } : undefined;
const newer = toLink(index > 0 ? siblings[index - 1] : undefined);
const older = toLink(index >= 0 ? siblings[index + 1] : undefined);
---

<BlogPost
	{...post.data}
	translations={translations}
	headings={headings}
	newer={newer}
	older={older}
>
	<Content />
</BlogPost>
