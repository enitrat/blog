---
import '@fontsource-variable/commissioner/wght.css';
import '@fontsource-variable/literata/wght.css';
import '../styles/site.css';

import Analytics from '@vercel/analytics/astro';
import paperTexture from '../assets/home/paper-fiber.webp';
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title: string;
	description: string;
	lang?: string;
}

const { title, description, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang} class="site">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body style={`--paper-texture: url(${paperTexture.src})`}>
		<div class="site-shell">
			<SiteHeader />
			<main>
				<slot />
			</main>
			<SiteFooter />
		</div>
		<Analytics />
	</body>
</html>
