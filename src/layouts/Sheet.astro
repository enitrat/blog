---
import '../styles/article.css';

import type { MarkdownHeading } from 'astro';
import CopyCodeButton from '../components/CopyCodeButton.astro';
import Page from './Page.astro';

/**
 * The reading surface for any long-form document. An adapter fills the `facts`
 * and `close` slots; everything else is fixed here.
 */
interface Props {
	title: string;
	description?: string;
	lang?: string;
	headings?: MarkdownHeading[];
}

const { title, description, lang = 'en', headings = [] } = Astro.props;

const labels: Record<string, Record<string, string>> = {
	en: { details: 'Document details', contents: 'Contents' },
	fr: { details: 'Détails du document', contents: 'Sommaire' },
};
const t = labels[lang] ?? labels.en;

// Rendered once and printed below, since the markup is the only place the
// contents-derived apparatus can be checked against.
const body = await Astro.slots.render('default');

// Deeper than h3 crowds the margin rather than helping anyone navigate.
const contents = headings
	.filter((heading) => heading.depth === 2 || heading.depth === 3)
	.map((heading) => ({ ...heading }));
---

<Page title={title} description={description ?? title} lang={lang} footerContact={false}>
	<Fragment slot="head">
		{/* Preloaded here rather than in the shared head: this is the only
		    surface that paints a code glyph. */}
		<link rel="preload" href="/fonts/roboto-mono-regular.woff2" as="font" type="font/woff2" crossorigin />
		<slot name="head" />
	</Fragment>

	<article class="sheet">
		<header class="sheet__head">
			<h1>{title}</h1>
			{description && <p class="sheet__standfirst">{description}</p>}
		</header>

		<div class="sheet__body">
			<aside class="sheet__margin" aria-label={t.details}>
				<slot name="facts" />

				{contents.length > 1 && (
					<nav class="sheet__contents" aria-label={t.contents} data-contents>
						<span>{t.contents}</span>
						<ol>
							{contents.map((heading) => (
								<li data-depth={heading.depth}>
									<a href={`#${heading.slug}`} data-contents-link={heading.slug}>
										<span class="t">{heading.text}</span>
									</a>
								</li>
							))}
						</ol>
					</nav>
				)}
			</aside>

			<div class="article-body" set:html={body} />
		</div>

		<footer class="sheet__close">
			<div>
				<slot name="close" />
			</div>
		</footer>
	</article>

	<CopyCodeButton />

	<script>
		function setupSheet() {
			const nav = document.querySelector<HTMLElement>('[data-contents]');
			if (!nav || nav.dataset.ready === 'true') return;
			nav.dataset.ready = 'true';

			const links = new Map<string, HTMLElement>();
			for (const link of nav.querySelectorAll<HTMLElement>('[data-contents-link]')) {
				const slug = link.dataset.contentsLink;
				if (slug) links.set(slug, link);
			}

			const targets = [...links.keys()]
				.map((slug) => document.getElementById(slug))
				.filter((el): el is HTMLElement => el !== null);
			if (targets.length === 0) return;

			let currentSlug: string | null = null;
			const mark = (slug: string | null) => {
				if (slug === currentSlug) return;
				currentSlug = slug;
				for (const [key, link] of links) {
					if (key === slug) link.setAttribute('aria-current', 'true');
					else link.removeAttribute('aria-current');
				}
			};

			// Nearest heading above the reading line wins, so the mark tracks what
			// is being read rather than whichever heading last crossed a threshold.
			const select = () => {
				const line = window.innerHeight * 0.28;
				let best: HTMLElement | null = null;
				for (const target of targets) {
					if (target.getBoundingClientRect().top <= line) best = target;
					else break;
				}
				mark(best ? best.id : null);
			};

			let queued = false;
			const onScroll = () => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(() => {
					queued = false;
					select();
				});
			};

			select();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onScroll, { passive: true });
		}

		setupSheet();
		document.addEventListener('astro:page-load', setupSheet);
	</script>
</Page>
