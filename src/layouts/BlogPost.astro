---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Sheet from './Sheet.astro';

type Translation = {
	lang: string;
	href: string;
	title: string;
};

type Adjacent = { href: string; title: string };

// Omitted because `related` arrives here already resolved from base slugs to
// links.
type Props = Omit<CollectionEntry<'blog'>['data'], 'related'> & {
	translations?: Translation[];
	headings?: MarkdownHeading[];
	newer?: Adjacent;
	older?: Adjacent;
	/** When present, these replace the chronological neighbours in the close. */
	related?: Adjacent[];
};

const langLabels: Record<string, string> = {
	en: '[EN] Read in English',
	fr: '[FR] Lire en français',
};

const uiLabels: Record<string, Record<string, string>> = {
	en: {
		published: 'Published',
		updated: 'Updated',
		alsoIn: 'Also in',
		previous: 'Previous',
		next: 'Next',
		related: 'Related',
		onward: 'More writing',
		allWriting: 'All writing',
		bookshelf: 'Bookshelf',
	},
	fr: {
		published: 'Publié',
		updated: 'Mis à jour',
		alsoIn: 'Aussi en',
		previous: 'Précédent',
		next: 'Suivant',
		related: 'Sur le même sujet',
		onward: "Plus d'écrits",
		allWriting: 'Tous les écrits',
		bookshelf: 'Bibliothèque',
	},
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	lang = 'en',
	translations = [],
	headings = [],
	newer,
	older,
	related = [],
} = Astro.props;

const t = uiLabels[lang] ?? uiLabels.en;
const dateLocale = lang === 'fr' ? 'fr-FR' : 'en-GB';
const formatDate = (date: Date) =>
	date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });

const onward =
	related.length > 0
		? related.slice(0, 2).map((item) => ({ ...item, label: t.related }))
		: [
				...(older ? [{ ...older, label: t.previous, rel: 'prev' }] : []),
				...(newer ? [{ ...newer, label: t.next, rel: 'next', next: true }] : []),
			];
---

<Sheet title={title} description={description} lang={lang} headings={headings}>
	<Fragment slot="head">
		{/* Translations appear in no index, so these are the only signal that the
		    two pages are one piece; without them a crawler sees duplicate content. */}
		{translations.length > 0 && (
			<Fragment>
				<link rel="alternate" hreflang={lang} href={new URL(Astro.url.pathname, Astro.site)} />
				{translations.map((tr) => (
					<link rel="alternate" hreflang={tr.lang} href={new URL(tr.href, Astro.site)} />
				))}
			</Fragment>
		)}
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description: description,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate || pubDate).toISOString(),
			})}
		/>
	</Fragment>

	<dl class="sheet__facts" slot="facts">
		<div>
			<dt>{t.published}</dt>
			<dd><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></dd>
		</div>
		{updatedDate && (
			<div>
				<dt>{t.updated}</dt>
				<dd>
					<time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
				</dd>
			</div>
		)}
		{translations.length > 0 && (
			<div>
				<dt>{t.alsoIn}</dt>
				{translations.map((tr) => (
					<dd>
						<a href={tr.href} hreflang={tr.lang} lang={tr.lang}>
							{langLabels[tr.lang] || tr.lang}
						</a>
					</dd>
				))}
			</div>
		)}
	</dl>

	<slot />

	<Fragment slot="close">
		{onward.length > 0 && (
			<nav class="sheet__onward" aria-label={t.onward}>
				{onward.map((item) => (
					<a
						class:list={['sheet__onward-item', 'next' in item && item.next && 'sheet__onward-item--next']}
						href={item.href}
						rel={'rel' in item ? item.rel : undefined}
					>
						<span>{item.label}</span>
						<strong>{item.title}</strong>
					</a>
				))}
			</nav>
		)}
		<div class="sheet__exits">
			<a class="sheet__all" href="/writing">
				<ArrowIcon direction="left" />
				{t.allWriting}
			</a>
			<a class="sheet__all" href="/bookshelf">
				<ArrowIcon />
				{t.bookshelf}
			</a>
			<ContactLinks />
		</div>
	</Fragment>
</Sheet>
