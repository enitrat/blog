{
	"name": "quiet-personal-index",
	"type": "light",
	"comment": "Syntax colours follow the bench: orange carries keywords and escapes, graphite carries identifiers, strings and punctuation step down the grey ladder, and the ground stays transparent so code remains part of the reading surface.",
	"colors": {
		"editor.background": "#00000000",
		"editor.foreground": "#171717"
	},
	"settings": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring"],
			"settings": {
				"foreground": "#6b6f76",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator",
				"storage",
				"storage.type",
				"storage.modifier",
				"variable.language"
			],
			"settings": {
				"foreground": "#c2410c"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic",
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#171717"
			}
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": {
				"foreground": "#171717"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template", "meta.string"],
			"settings": {
				"foreground": "#575b62"
			}
		},
		{
			"scope": ["constant.numeric", "constant.language"],
			"settings": {
				"foreground": "#171717"
			}
		},
		{
			"scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable"],
			"settings": {
				"foreground": "#171717"
			}
		},
		{
			"scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
			"settings": {
				"foreground": "#6b6f76"
			}
		},
		{
			"scope": ["entity.other.attribute-name", "support.type.property-name"],
			"settings": {
				"foreground": "#c2410c"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#171717"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#c2410c"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#c2410c"
			}
		},
		{
			"scope": ["constant.character.escape", "constant.regexp"],
			"settings": {
				"foreground": "#c2410c"
			}
		}
	]
}
