---
interface Props {
	// Surfaces that already show the marked contact pair in their own close pass
	// false, so one screen never carries the same unresolved placeholder twice.
	contact?: boolean;
}

const { contact = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span>Mathieu Saugé</span>
	<nav aria-label="Footer navigation">
		<a href="/writing">Writing</a>
		<a href="/bookshelf">Bookshelf</a>
		<a href="/about">About</a>
		<a href="/rss.xml">RSS</a>
	</nav>
	{/*
		PRODUCT.md names X and Telegram as the route a visitor uses to start a
		conversation, and that is the site's stated success condition — so every
		surface has to show it, not just the homepage close. The destinations are
		still unresolved, so these carry the same dashed non-link marking the
		homepage uses. Replace both with real links when the destinations exist;
		do not delete them, or the promise goes silently missing.
	*/}
	{contact && (
		<span class="site-footer__contact" role="note" aria-label="Contact placeholders">
			<span>X placeholder</span>
			<span>Telegram placeholder</span>
		</span>
	)}
	<span>© {year}</span>
</footer>
