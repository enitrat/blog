---
interface Props {
	/** Pass false on surfaces that already show the contact pair in their own close. */
	contact?: boolean;
}

const { contact = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span>Mathieu Saugé</span>
	<nav aria-label="Footer navigation">
		<a href="/writing">Writing</a>
		<a href="/bookshelf">Bookshelf</a>
		<a href="/about">About</a>
		<a href="/rss.xml">RSS</a>
	</nav>
	{/* Give X and Telegram real hrefs once the handles exist. Deleting them
	    instead drops the site's only invitation to start a conversation. */}
	{contact && (
		<span class="site-footer__contact">
			<a href="https://github.com/enitrat" rel="me noreferrer" target="_blank">GitHub</a>
			<span role="note">X placeholder</span>
			<span role="note">Telegram placeholder</span>
		</span>
	)}
	<span>© {year}</span>
</footer>
