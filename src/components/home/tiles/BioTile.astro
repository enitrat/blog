---
/** BioTile: Mathieu's sentence, role, and the three ways to reach him. */
import { CONTACT_LINKS } from '../../../consts';
import Link from '../../ui/Link.astro';
import Pill from '../../ui/Pill.astro';
import Tile from '../../ui/Tile.astro';
import AgePlate from '../glyphs/AgePlate.astro';
import Barbell from '../glyphs/Barbell.astro';
import Book from '../glyphs/Book.astro';
import Turntable from '../glyphs/Turntable.astro';

interface Props {
	order?: number;
}
const { order } = Astro.props;
---

<Tile span={{ md: 6, lg: 5 }} rows={{ lg: 4 }} {order} as="section" aria-labelledby="bio-title">
	<div class="bio">
		<div class="intro">
			<h1 id="bio-title">
				<span>Hi! I'm Mathieu.</span>
				<span>An engineer working in DeFi.</span>
			</h1>
		</div>
		<div class="facts">
			<p>Fun facts:</p>
			<ul>
				<li data-glyph-host><AgePlate size={40} /><span>I'm 25</span></li>
				<li data-glyph-host><Turntable size={40} /><span>I record DJ sets on soundcloud</span></li>
				<li data-glyph-host><Barbell size={40} /><span>I'm on a quest to bench 100kg</span></li>
				<li data-glyph-host><Book size={40} /><span>I enjoy classical literature a lot</span></li>
			</ul>
		</div>
		<div class="foot">
			<p>
				Senior Protocol Engineer at <Link href="/work/zama/">Zama</Link>
			</p>
			<nav aria-label="Contact" class="pills">
				{CONTACT_LINKS.map((c) => <Pill href={c.href} rel="me noreferrer" target="_blank">{c.label}</Pill>)}
			</nav>
		</div>
	</div>
</Tile>

<style>
	.bio {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-8);
		height: 100%;
	}
	h1 {
		display: grid;
		gap: var(--space-3);
		font-size: var(--text-title);
		font-weight: var(--weight-ui);
		line-height: var(--leading-display);
		letter-spacing: var(--tracking-display);
		text-wrap: balance;
	}
	.facts {
		display: grid;
		gap: var(--space-3);
		color: var(--muted-foreground);
		font-size: var(--text-ui);
		line-height: var(--leading-body);
	}
	.facts ul {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.facts li {
		display: grid;
		grid-template-columns: var(--space-10) 1fr;
		align-items: center;
		gap: var(--space-4);
		padding-block: var(--space-2);
		color: var(--foreground);
	}
	.foot {
		display: grid;
		gap: var(--space-4);
		font-size: var(--text-ui);
		color: var(--muted-foreground);
	}
	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
</style>
