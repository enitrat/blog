---
/** BioTile: Mathieu's sentence, role, and the three ways to reach him. */
import { CONTACT_LINKS } from '../../../consts';
import Link from '../../ui/Link.astro';
import Pill from '../../ui/Pill.astro';
import Tile from '../../ui/Tile.astro';

interface Props {
	order?: number;
}
const { order } = Astro.props;
---

<Tile span={{ md: 6, lg: 5 }} rows={{ lg: 4 }} {order} as="section" aria-labelledby="bio-title">
	<div class="bio">
		<div class="intro">
			<h1 id="bio-title">
				<span>Hi! I'm Mathieu.</span>
				<span>An engineer working in DeFi.</span>
			</h1>
			<div class="facts">
				<p>Fun facts:</p>
				<ul>
					<li>I'm 25</li>
					<li>I record DJ sets on soundcloud</li>
					<li>I'm on a quest to bench 100kg</li>
					<li>I enjoy classical literature a lot</li>
				</ul>
			</div>
		</div>
		<div class="foot">
			<p>
				Senior Protocol Engineer at <Link href="/work/zama/">Zama</Link>
			</p>
			<nav aria-label="Contact" class="pills">
				{CONTACT_LINKS.map((c) => <Pill href={c.href} rel="me noreferrer" target="_blank">{c.label}</Pill>)}
			</nav>
		</div>
	</div>
</Tile>

<style>
	.bio {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-8);
		height: 100%;
	}
	.intro {
		display: grid;
		gap: var(--space-4);
	}
	h1 {
		display: grid;
		gap: var(--space-3);
		font-size: var(--text-title);
		font-weight: var(--weight-ui);
		line-height: var(--leading-display);
		letter-spacing: var(--tracking-display);
		text-wrap: balance;
	}
	.facts {
		display: grid;
		gap: var(--space-2);
		color: var(--muted-foreground);
		font-size: var(--text-ui);
		line-height: var(--leading-body);
	}
	.facts ul {
		margin: 0;
		padding-left: 1.15em;
	}
	.foot {
		display: grid;
		gap: var(--space-4);
		font-size: var(--text-ui);
		color: var(--muted-foreground);
	}
	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
</style>
