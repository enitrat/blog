---
/**
 * WritingTile: the last three posts as a stack of index cards: the newest in front and readable
 *   at rest, the others peeking out behind. Hovering or focusing inside fans them left and up
 *   over the neighbouring tiles. Where hover is unavailable, or the tile is narrow, the same
 *   three cards show as a scrolling row. Each card links to its post.
 * @prop order Position on the phone grid (passed to `Tile`)
 */
import { bannerFor, getWritingIndex, postUrl } from '../../../utils/writing';
import Fan from '../../ui/Fan.astro';
import FanItem from '../../ui/FanItem.astro';
import Link from '../../ui/Link.astro';
import PostCard from '../../ui/PostCard.astro';
import Tile from '../../ui/Tile.astro';

interface Props {
	order?: number;
}
const { order } = Astro.props;
const posts = (await getWritingIndex()).slice(0, 3);
const latest = posts[0];
// Poses per stack index: a small stack at rest, then rotated about -12, -6 and +4 degrees and
// dealt left and up over the neighbours, never past the tile's right edge.
const poses = [
	{ rest: { r: 0 }, open: { x: '-100%', y: '-14%', r: -12 } },
	{ rest: { x: '6%', y: '-4%', r: 3 }, open: { x: '-50%', y: '-24%', r: -6 } },
	{ rest: { x: '12%', y: '-8%', r: 6 }, open: { x: '4%', y: '-6%', r: 4 } },
];
---

{
	latest && (
		<Tile label="Writing" labelAs="h2" spill data-fan-host span={{ md: 6, lg: 4 }} order={order} as="section">
			<Link slot="action" variant="arrow" href="/writing/">All writing</Link>
			<div class="writing">
				<Fan host="ancestor" class="stack">
					{posts.map((p, i) => (
						<FanItem i={i} {...poses[i]}>
							<PostCard href={postUrl(p)} title={p.data.title} description={p.data.description} date={p.data.pubDate} image={bannerFor(p)} headingLevel={3} />
						</FanItem>
					))}
				</Fan>
				<ul class="row">
					{posts.map((p) => (
						<li>
							<PostCard href={postUrl(p)} title={p.data.title} description={p.data.description} date={p.data.pubDate} image={bannerFor(p)} headingLevel={3} size="sm" />
						</li>
					))}
				</ul>
			</div>
		</Tile>
	)
}

<style>
	.writing {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
	}
	.writing :global(.stack) {
		--fan-w: min(78%, 17rem);
		/* the back cards peek out to the right: shift left so the stack stays inside the tile */
		translate: -8% 0;
	}
	.row {
		display: none;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* no hover, or a narrow tile: the three cards as a row, nothing hidden behind anything */
	@media (hover: none), (max-width: 40rem) {
		.writing {
			display: block;
		}
		.writing :global(.stack) {
			display: none;
		}
		.row {
			display: flex;
			gap: var(--space-3);
			overflow-x: auto;
			padding-block: var(--space-2);
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}
		.row li {
			flex: 0 0 min(72%, 15rem);
			scroll-snap-align: start;
		}
	}
</style>
