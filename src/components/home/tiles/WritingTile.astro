---
/**
 * WritingTile: the last three posts as a stack of index cards: the newest in front and readable
 *   at rest, the others peeking out behind; while the tile is in view and untouched the front card is
 *   dealt to the back every 5s. Hovering or focusing inside fans them in place, inside the tile, and
 *   the card under the pointer comes forward. Where hover is unavailable, or the
 *   tile is narrow, the same three cards show as a scrolling row. Each card links to its post.
 * @prop order Position on the phone grid (passed to `Tile`)
 */
import { bannerFor, getWritingIndex, postUrl } from '../../../utils/writing';
import Deck from '../../ui/Deck.astro';
import Link from '../../ui/Link.astro';
import PostCard from '../../ui/PostCard.astro';
import Tile from '../../ui/Tile.astro';

interface Props {
	order?: number;
}
const { order } = Astro.props;
const posts = (await getWritingIndex()).slice(0, 3);
const latest = posts[0];
---

{
	latest && (
		<Tile label="Writing" labelAs="h2" data-deck-host span={{ md: 6, lg: 4 }} order={order} as="section">
			<Link slot="action" variant="arrow" href="/writing/">All writing</Link>
			<div class="writing">
				<Deck items={posts} host="ancestor" class="stack" label="Latest writing" spread={0.22} angle={5} cycle={5}>
					{(p: (typeof posts)[number]) => (
						<PostCard href={postUrl(p)} title={p.data.title} description={p.data.description} date={p.data.pubDate} image={bannerFor(p)} headingLevel={3} />
					)}
				</Deck>
				<ul class="row">
					{posts.map((p) => (
						<li>
							<PostCard href={postUrl(p)} title={p.data.title} description={p.data.description} date={p.data.pubDate} image={bannerFor(p)} headingLevel={3} size="sm" />
						</li>
					))}
				</ul>
			</div>
		</Tile>
	)
}

<style>
	.writing {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
	}
	.writing :global(.stack) {
		--deck-max: 15rem;
		margin-bottom: var(--space-4);
	}
	.row {
		display: none;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* no hover, or a narrow tile: the three cards as a row, nothing hidden behind anything */
	@media (hover: none), (max-width: 40rem) {
		.writing {
			display: block;
		}
		.writing :global(.stack) {
			display: none;
		}
		.row {
			display: flex;
			gap: var(--space-3);
			overflow-x: auto;
			padding-block: var(--space-2);
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}
		.row li {
			flex: 0 0 min(72%, 15rem);
			scroll-snap-align: start;
		}
	}
</style>
