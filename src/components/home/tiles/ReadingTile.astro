---
/**
 * ReadingTile: the books being read now as a stack of covers, each with a glow in its dominant
 *   colour. Hover fans them like a hand of two; the cover under the pointer comes forward. The whole tile links to /reading. With no current book it
 *   shows the last one finished.
 * @prop order Position on the phone grid (passed to `Tile`)
 */
import { books } from '../../../booksData';
import { coverFor } from '../../../utils/covers';
import { glowOf } from '../../../utils/glow';
import Deck from '../../ui/Deck.astro';
import Plate from '../../ui/Plate.astro';
import Tile from '../../ui/Tile.astro';

interface Props {
	order?: number;
}
const { order } = Astro.props;
const stamp = (d: Date | null) => d?.getTime() ?? 0;
const current = books
	.filter((b) => b.status === 'reading')
	.sort((a, b) => stamp(b.dateStarted) - stamp(a.dateStarted));
const last = books
	.filter((b) => b.status === 'finished')
	.sort((a, b) => stamp(b.dateFinished) - stamp(a.dateFinished))[0];
const label = current.length ? 'Reading' : 'Last read';
const shown = (current.length ? current : last ? [last] : []).slice(0, 2);
const stack = await Promise.all(
	shown.map(async (book) => {
		const cover = coverFor(book.edition.isbn13);
		return { book, cover, glow: cover ? await glowOf(cover) : undefined };
	}),
);
const front = stack[0]?.book;
---

<Tile {label} href="/reading/" data-deck-host span={{ md: 3, lg: 4 }} {order} meta={current.length > 1 ? `+${current.length - 1} more` : undefined}>
	{front && (
		<div class="reading">
			<Deck items={stack} host="ancestor" class="stack" spread={0.6} angle={5}>
				{({ book, cover, glow }: (typeof stack)[number]) => (
					<Plate src={cover} alt="" glow={glow} sizes="12rem" widths={[240, 480]}>
						<span class="fallback">
							<strong>{book.title.replace(/\s*\(.*\)\s*$/, '')}</strong>
							<span>{book.author}</span>
						</span>
					</Plate>
				)}
			</Deck>
			<p class="title">{front.title.replace(/\s*\(.*\)\s*$/, '')}</p>
			<p class="by">{front.author}</p>
		</div>
	)}
</Tile>

<style>
	.reading {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-align: right;
	}
	.reading :global(.stack) {
		--deck-max: 13rem;
		--deck-glow: 0.18;
		--plate-glow-inset: -2%;
		margin-block: auto;
	}
	@media (max-width: 40rem) {
		.reading :global(.stack) {
			--deck-max: 9rem;
		}
	}
	.title {
		margin-top: var(--space-4);
		font-size: var(--text-ui);
		font-weight: var(--weight-title);
		line-height: var(--leading-ui);
	}
	.by {
		font-size: var(--text-small);
		line-height: var(--leading-ui);
		color: var(--muted-foreground);
	}
	.fallback {
		display: grid;
		align-content: end;
		gap: var(--space-1);
		height: 100%;
		padding: var(--space-3);
		text-align: left;
		font-size: var(--text-small);
		color: var(--muted-foreground);
	}
	.fallback strong {
		color: var(--foreground);
		font-weight: var(--weight-title);
	}
</style>
