---
/**
 * ReadingTile: the books being read now as a pile of covers, each with a glow in its dominant
 *   colour. Hover pulls the book under the pointer up and out of the pile; letting go squares the
 *   pile. A Readout under it follows the held book (title, author). The whole tile links to
 *   /reading. With no current book it shows the last one finished.
 * @prop order Position on the phone grid (passed to `Tile`)
 */
import { books } from '../../../booksData';
import { coverFor } from '../../../utils/covers';
import { glowOf } from '../../../utils/glow';
import Deck from '../../ui/Deck.astro';
import Plate from '../../ui/Plate.astro';
import Readout from '../../ui/Readout.astro';
import Tile from '../../ui/Tile.astro';

interface Props {
	order?: number;
}
const { order } = Astro.props;
const stamp = (d: Date | null) => d?.getTime() ?? 0;
const current = books
	.filter((b) => b.status === 'reading')
	.sort((a, b) => stamp(b.dateStarted) - stamp(a.dateStarted));
const last = books
	.filter((b) => b.status === 'finished')
	.sort((a, b) => stamp(b.dateFinished) - stamp(a.dateFinished))[0];
const label = current.length ? 'Reading' : 'Last read';
const shown = (current.length ? current : last ? [last] : []).slice(0, 2);
const stack = await Promise.all(
	shown.map(async (book) => {
		const cover = coverFor(book.edition.isbn13);
		return { book, cover, glow: cover ? await glowOf(cover) : undefined };
	}),
);
const short = (t: string) => t.replace(/\s*\(.*\)\s*$/, '');
const captions = stack.map(({ book }) => ({ title: short(book.title), author: book.author }));
---

<Tile {label} href="/reading/" data-deck-host span={{ md: 3, lg: 4 }} {order} meta={current.length > 1 ? `+${current.length - 1} more` : undefined}>
	{captions.length > 0 && (
		<div class="reading">
			<Deck id="reading-deck" items={stack} captions={captions} hold="pull" lift={9} host="ancestor" class="stack">
				{({ book, cover, glow }: (typeof stack)[number]) => (
					<Plate src={cover} alt="" glow={glow} sizes="12rem" widths={[240, 480]}>
						<span class="fallback">
							<strong>{short(book.title)}</strong>
							<span>{book.author}</span>
						</span>
					</Plate>
				)}
			</Deck>
			<div class="caption">
				<Readout follow="reading-deck" field="title" value={captions[0].title} class="title" />
				<Readout follow="reading-deck" field="author" value={captions[0].author} class="by" />
			</div>
		</div>
	)}
</Tile>

<style>
	.reading {
		display: flex;
		flex-direction: column;
		height: 100%;
		/* room above the pile for a pulled book to rise into, clear of the header */
		padding-top: var(--space-8);
		text-align: right;
		--readout-justify: end;
	}
	.reading :global(.stack) {
		--deck-max: min(12rem, 62%);
		--deck-glow: 0.18;
		--plate-glow-inset: -2%;
		margin-block: auto;
	}
	@media (max-width: 40rem) {
		.reading :global(.stack) {
			--deck-max: 9rem;
		}
	}
	.caption {
		margin-top: var(--space-4);
	}
	.caption :global(.title) {
		font-size: var(--text-ui);
		font-weight: var(--weight-title);
		line-height: var(--leading-ui);
	}
	.caption :global(.by) {
		font-size: var(--text-small);
		line-height: var(--leading-ui);
		color: var(--muted-foreground);
	}
	.fallback {
		display: grid;
		align-content: end;
		gap: var(--space-1);
		height: 100%;
		padding: var(--space-3);
		text-align: left;
		font-size: var(--text-small);
		color: var(--muted-foreground);
	}
	.fallback strong {
		color: var(--foreground);
		font-weight: var(--weight-title);
	}
</style>
