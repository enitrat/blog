---
import { Picture } from 'astro:assets';
import poster from '../../assets/living-room.png';
import sheets from '../../assets/room/sheets.json';
import { getWritingIndex, postUrl } from '../../utils/writing';
import Bookshelf from './room/Bookshelf.astro';

// The manuscripts on the desk are baked, one per piece the bake knew about.
// A piece published since is on /writing/ but not yet on the desk; the bake
// is the only thing that can put it there, so it is left off rather than
// given a target with nothing under it.
const posts = await getWritingIndex();
const manuscripts = sheets.flatMap((sheet) => {
	const post = posts.find((entry) => entry.id === sheet.slug);
	return post ? [{ slug: sheet.slug, title: post.data.title, href: postUrl(post) }] : [];
});
---

<div class="living-room" data-room>
	<div class="living-room__stage" data-room-stage>
	<Picture
		class="living-room__poster"
		src={poster}
		alt="A miniature living room: Pléiade books and records, a walnut hi-fi with a turntable, a pleated floor lamp, a patterned rug, and an oak writing desk with manuscripts under a green banker's lamp."
		widths={[640, 960, 1440]}
		sizes="(max-width: 64rem) 100vw, 64rem"
		formats={['avif']}
		fallbackFormat="webp"
		loading="eager"
		fetchpriority="high"
		decoding="sync"
	/>
	<!-- The scene itself is the camera control once it is live: scene.ts names it
	     and makes it focusable, so there is no chrome over the artwork. -->
	<canvas class="living-room__canvas" aria-hidden="true"></canvas>

	<div class="living-room__hotspots">
		<a class="living-room__hotspot" href="#room-library" data-anchor="bookshelf">
			Browse the bookshelf
		</a>
		<button class="living-room__hotspot" type="button" data-anchor="record" aria-pressed="false">
			Play the record
		</button>

		<a class="living-room__hotspot" href="/writing/" data-anchor="desk">
			Sit at the desk
		</a>

		<a
			class="living-room__hotspot living-room__mix"
			href="https://soundcloud.com/user2211512"
			data-anchor="record"
			rel="noopener"
		>
			Latest mix from my SoundCloud&nbsp;<span aria-hidden="true">↗</span>
		</a>
	</div>

	<p class="living-room__caption" aria-hidden="true"></p>
	<div class="room-book-targets" data-book-targets hidden aria-label="Books on this shelf"></div>
	<!-- Real links over the baked manuscripts: the scene lays each over the
	     sheet it names once the camera is at the desk. -->
	<nav class="room-desk-targets" data-desk-targets hidden aria-label="Manuscripts on the desk">
		{manuscripts.map((piece) => (
			<a class="room-desk__sheet" href={piece.href} data-sheet={piece.slug} hidden>{piece.title}</a>
		))}
	</nav>

	<!-- Camera chrome lives over the artwork, not under it: one chevron asset,
	     rotated, points back out and along the shelves. -->
	<div class="room-controls">
		<svg width="0" height="0" aria-hidden="true" focusable="false">
			<symbol id="room-chevron" viewBox="0 0 24 24">
				<path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
			</symbol>
		</svg>
		<button class="room-controls__back" type="button" data-shelf-exit>
			<svg viewBox="0 0 24 24" aria-hidden="true"><use href="#room-chevron" /></svg>
			<span data-shelf-exit-label>Back to the room</span>
		</button>
		<p class="room-controls__status" role="status" data-shelf-status></p>
		<button class="room-controls__step" type="button" data-row-previous aria-label="Look at the shelf above">
			<svg viewBox="0 0 24 24" aria-hidden="true"><use href="#room-chevron" /></svg>
		</button>
		<button class="room-controls__step" type="button" data-row-next aria-label="Look at the shelf below">
			<svg viewBox="0 0 24 24" aria-hidden="true"><use href="#room-chevron" /></svg>
		</button>
		<button class="room-controls__pan" type="button" data-shelf-previous aria-label="More books to the left" hidden>
			<svg viewBox="0 0 24 24" aria-hidden="true"><use href="#room-chevron" /></svg>
		</button>
		<button class="room-controls__pan" type="button" data-shelf-next aria-label="More books to the right" hidden>
			<svg viewBox="0 0 24 24" aria-hidden="true"><use href="#room-chevron" /></svg>
		</button>
		<button class="room-controls__audio" type="button" data-shelf-audio hidden>Stop the record</button>
	</div>
	</div>
	<Bookshelf />
</div>

<script>
	import { mountBookshelf } from './room/bookshelf';

	const room = document.querySelector<HTMLElement>('[data-room]');
	const canvas = room?.querySelector<HTMLCanvasElement>('.living-room__canvas');

	const player = room?.querySelector<HTMLButtonElement>('[data-anchor="record"]');
	const shelfPlayer = room?.querySelector<HTMLButtonElement>('[data-shelf-audio]');

	// The rings carry no text; the caption at the lower edge names whatever the
	// pointer or keyboard has reached, one at a time. That element has a single
	// owner: while browsing, the bookshelf is naming rows and books with it, so
	// the room asks through `label()` rather than writing to it.
	const hotspots = room?.querySelector<HTMLElement>('.living-room__hotspots');
	const label = (text: string) => bookshelf?.label(text);
	const named = (event: Event) => {
		const spot = (event.target as Element).closest?.('.living-room__hotspot');
		const ring = spot && !spot.classList.contains('living-room__mix');
		label(ring ? (spot.textContent ?? '').trim() : '');
	};
	const pointed = () =>
		room?.querySelector<HTMLElement>(
			'.living-room__hotspot:is(:hover, :focus-visible):not(.living-room__mix)',
		);
	hotspots?.addEventListener('pointerover', named);
	hotspots?.addEventListener('pointerout', () => label(''));
	hotspots?.addEventListener('focusin', named);
	hotspots?.addEventListener('focusout', () => label(''));

	/** Surface noise, built once and left in place. Creating and closing an
	 *  AudioContext per play raced its own teardown: a second press inside the
	 *  fade could leave two contexts running and one of them unreachable. */
	function surface() {
		const context = new AudioContext();
		const buffer = context.createBuffer(1, context.sampleRate * 2, context.sampleRate);
		const samples = buffer.getChannelData(0);
		for (let i = 0; i < samples.length; i++) {
			samples[i] =
				(Math.random() - 0.5) * 0.06 + (Math.random() < 0.0008 ? (Math.random() - 0.5) * 0.7 : 0);
		}
		const source = context.createBufferSource();
		source.buffer = buffer;
		source.loop = true;

		const low = context.createBiquadFilter();
		low.type = 'highpass';
		low.frequency.value = 700;
		const high = context.createBiquadFilter();
		high.type = 'lowpass';
		high.frequency.value = 6000;
		const gain = context.createGain();
		gain.gain.value = 0;
		source.connect(low).connect(high).connect(gain).connect(context.destination);
		source.start();
		let idle: ReturnType<typeof setTimeout> | undefined;
		const ramp = (to: number, seconds: number) => {
			gain.gain.cancelScheduledValues(context.currentTime);
			gain.gain.setValueAtTime(gain.gain.value, context.currentTime);
			gain.gain.linearRampToValueAtTime(to, context.currentTime + seconds);
		};
		return {
			needle() {
				clearTimeout(idle);
				void context.resume();
				ramp(0.5, 0.35);
			},
			bed() {
				ramp(0.09, 0.6);
			},
			lift() {
				ramp(0, 0.25);
				idle = setTimeout(() => void context.suspend(), 400);
			},
		};
	}
	let noise: ReturnType<typeof surface> | null = null;

	type Widget = {
		play(): void;
		pause(): void;
		getPosition(callback: (ms: number) => void): void;
		bind(event: string, handler: () => void): void;
	};
	type SoundCloud = ((frame: Element) => Widget) & {
		Events: { PLAY: string; PAUSE: string; FINISH: string; ERROR: string; READY: string };
	};
	let widget: Widget | null = null;
	let connecting: Promise<Widget> | null = null;

	/** One state, not two booleans that could disagree. `cueing` is the honest
	 *  name for what the old code told the room was playing: the needle is down
	 *  and the surface noise is audible, but the mix has not started yet. */
	type Playback = 'stopped' | 'cueing' | 'playing';
	let playback: Playback = 'stopped';

	function set(next: Playback) {
		playback = next;
		const on = next !== 'stopped';
		player?.setAttribute('aria-pressed', String(on));
		if (shelfPlayer) shelfPlayer.hidden = !on;
		if (player) player.textContent = on ? 'Stop the record' : 'Play the record';
		// The platter turns from `cueing` on, because by then something really is
		// coming out of the speaker. `data-mix` is the one that means the mix.
		room?.toggleAttribute('data-playing', on);
		if (next !== 'playing') room?.removeAttribute('data-mix');
		// The button's own label just changed. If it is the thing being pointed
		// at, the caption is naming it and has to say the new thing.
		const spot = pointed();
		if (spot) label((spot.textContent ?? '').trim());
	}

	async function connect() {
		const frame = document.createElement('iframe');
		frame.className = 'living-room__widget';
		frame.title = 'SoundCloud player: Bounce Nationale by eni';

		frame.allow = 'autoplay; encrypted-media';
		frame.src =
			'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/2360410595&auto_play=false&hide_related=true&show_comments=false&show_teaser=false';
		document.body.append(frame);

		await new Promise((resolve, reject) => {
			const api = document.createElement('script');
			api.src = 'https://w.soundcloud.com/player/api.js';
			api.onload = resolve;
			api.onerror = reject;
			document.head.append(api);
		});

		const SC = (window as Window & { SC?: { Widget: SoundCloud } }).SC;
		if (!SC) throw new Error('no SC.Widget');
		const created = SC.Widget(frame);
		const events = SC.Widget.Events;

		created.bind(events.PLAY, () => {
			if (playback === 'stopped') return created.pause();
			set('playing');
			noise?.bed();

			room?.setAttribute('data-mix', '');
		});
		created.bind(events.PAUSE, () => {
			if (document.hidden) return;

			created.getPosition((position) => {
				if (position > 0) stop();
				else room?.removeAttribute('data-mix');
			});
		});
		created.bind(events.FINISH, stop);
		created.bind(events.ERROR, stop);

		created.bind(events.READY, () => playback !== 'stopped' && created.play());
		return created;
	}

	function stop() {
		widget?.pause();
		noise?.lift();
		set('stopped');
	}

	function toggle() {
		if (playback !== 'stopped') {
			stop();
			return;
		}

		try {
			noise ??= surface();
			noise.needle();
		} catch {}
		set('cueing');
		if (widget) {
			widget.play();
			return;
		}
		// One iframe and one api.js however fast the button is pressed: without
		// this, a second press before the first resolves appends a second player
		// that nobody holds a reference to and nothing can ever pause.
		connecting ??= connect();
		connecting.then(
			(created) => {
				widget = created;
			},
			() => {
				connecting = null;
			},
		);
	}

	player?.addEventListener('click', toggle);
	shelfPlayer?.addEventListener('click', toggle);

	let resume = false;
	document.addEventListener('visibilitychange', () => {
		if (document.hidden) {
			// Only a mix that actually started is worth resuming: intent that
			// never became playback should not begin on its own on the way back.
			resume = playback === 'playing';
			if (resume) widget?.pause();
		} else if (resume) {
			resume = false;
			widget?.play();
		}
	});

	function supportsWebGL() {
		try {
			return !!document.createElement('canvas').getContext('webgl2');
		} catch {
			return false;
		}
	}

	// Asked once. Every call allocates a real WebGL2 context on a throwaway
	// canvas, and browsers evict the oldest live context when there are too
	// many -- which, asked on every hash change, would be the room's own.
	const canRender = supportsWebGL();
	const coarse = matchMedia('(pointer: coarse)').matches;
	const memory = (navigator as { deviceMemory?: number }).deviceMemory ?? 8;
	const saveData =
		(navigator as { connection?: { saveData?: boolean } }).connection?.saveData === true;

	// Tell the bookshelf a renderer is possible before it mounts, so an entrance
	// click during the load still means "browse" rather than "jump to the list".
	if (room && canvas && canRender) room.dataset.canRender = '';
	const bookshelf = room ? mountBookshelf(room) : undefined;

	if (room && canvas && bookshelf) {
		let loading: Promise<void> | undefined;
		const load = () => {
			if (loading) return loading;
			room.setAttribute('aria-busy', 'true');
			loading = (async () => {
				try {
					const { mountRoom } = await import('./room/scene');
					// mountRoom sets data-live itself, and registers its own pagehide.
					if (!(await mountRoom(room, canvas, bookshelf))) bookshelf.fallback();
				} catch (error) {
					console.error('The room could not load.', error);
					bookshelf.fallback();
				} finally {
					room.removeAttribute('aria-busy');
				}
			})();
			return loading;
		};
		// Explicit activation always loads; the eager path stays off touch, where
		// the poster and the list already answer the page.
		room.querySelector('[data-anchor="bookshelf"]')?.addEventListener('click', () => {
			if (canRender) void load();
		});
		addEventListener('hashchange', () => {
			if (bookshelf.active && canRender) void load();
		});
		const idle = window.requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 200));
		if ((bookshelf.active || (!coarse && memory >= 4 && !saveData)) && canRender) {
			const boot = () => idle(() => { void load(); }, { timeout: 3000 });
			if (document.readyState === 'complete') boot();
			else addEventListener('load', boot, { once: true });
		}
		addEventListener('pagehide', (event) => { if (!event.persisted) bookshelf.dispose(); });
	}
</script>
