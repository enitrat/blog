---
/** AgePlate: a small tag with "25" printed on its top face, in the iso plane. */
import IsoGlyph from '../../ui/IsoGlyph.astro';
import { box, P } from '../../ui/iso';

interface Props {
	size?: number;
}
const { size } = Astro.props;
const b = box(-11, -15, 11, 15, 0, 3);
const top = P(0, 0, 3);
---

<IsoGlyph size={size} frame={[0, -2.2, 43]}>
	<g transform="scale(1.2)"><g class="iso-part" style="--pose: translate(0, -1.5px)">
		<polygon class="l" points={b.left} />
		<polygon class="r" points={b.right} />
		<polygon class="t" points={b.top} />
		<g transform={`translate(${top.join(' ')}) matrix(0.7071 -0.3536 0.7071 0.3536 0 0)`}>
			<circle class="hole" cx="-12" cy="-7.5" r="1.3" />
			<g transform="translate(-6 -6.5) scale(1.3)" class="digits">
				<path d="M0.5 2.6C0.5 0.4 5.6 0.4 5.6 3C5.6 5.6 0.5 7.4 0.5 9.6H5.6" />
				<path transform="translate(8.5 0)" d="M5.3 0.5H1.2L0.8 4.4C3 3.4 5.7 4 5.7 6.7C5.7 9.7 2 10.3 0.4 8.8" />
			</g>
		</g>
	</g></g>
</IsoGlyph>

<style>
	.digits path {
		fill: none;
		stroke-width: 1.5px;
		vector-effect: none;
	}
	.hole {
		fill: var(--iso-right);
	}
</style>
