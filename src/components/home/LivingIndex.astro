---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowIcon from '../ArrowIcon.astro';
import ContactLinks from '../ContactLinks.astro';

export interface LivingIndexItem {
	id: string;
	title: string;
	href: string;
	description: string;
	art: ImageMetadata;
}

interface Props {
	work: LivingIndexItem[];
	writing: LivingIndexItem[];
}

const { work, writing } = Astro.props;
const allItems = [...work, ...writing];
const initialId = work[0]?.id ?? writing[0]?.id;
---

<section class="living-index" data-living-index data-active-id={initialId} aria-label="Work and writing index">
	<div class="living-index__orientation">
		<h1>Mathieu<br />Saugé</h1>
		<p class="living-index__role">
			Software Engineer
			<span>CTO of Kakarot</span>
		</p>
		<div class="living-index__contact">
			<ContactLinks />
		</div>
		<div class="living-index__intro">
			<p>
				I like building consumer products end to end and have solid experience working in the
				DeFi industry. This is my little corner of the internet, where you'll find some of my
				work, my projects, and the things that appealed to me.
			</p>
		</div>
	</div>

	<div class="living-index__groups">
		<section class="index-group" aria-labelledby="work-index-title">
			<div class="index-group__heading">
				<h2 id="work-index-title">Work</h2>
				<a href="/work">All field reports</a>
			</div>
			<ul>
				{work.map((item) => (
					<li>
						<a
							href={item.href}
							data-stage-trigger={item.id}
							data-active={item.id === initialId ? 'true' : 'false'}
						>
							<span>{item.title}</span>
							<small>{item.description}</small>
							<ArrowIcon />
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class="index-group" aria-labelledby="writing-index-title">
			<div class="index-group__heading">
				<h2 id="writing-index-title">Writing</h2>
				<a href="/writing">Browse all writing</a>
			</div>
			<ul>
				{writing.map((item) => (
					<li>
						<a href={item.href} data-stage-trigger={item.id} data-active="false">
							<span>{item.title}</span>
							<small>{item.description}</small>
							<ArrowIcon />
						</a>
					</li>
				))}
			</ul>
		</section>
	</div>

	{/* Deliberately not a live region: the artwork is decorative, so announcing
	    it would narrate a hover ornament over whatever the reader is doing. */}
	<div class="art-stage">
		{allItems.map((item) => (
			<figure data-stage-frame={item.id} data-active={item.id === initialId ? 'true' : 'false'} aria-hidden={item.id === initialId ? 'false' : 'true'}>
				<Picture
					src={item.art}
					formats={['avif', 'webp']}
					widths={[640, 960, 1440, 1792]}
					sizes="(max-width: 760px) 100vw, 94vw"
					alt=""
					loading={item.id === initialId ? 'eager' : 'lazy'}
					fetchpriority={item.id === initialId ? 'high' : 'auto'}
				/>
				<figcaption>
					<span>Placeholder artwork</span>
					<strong>{item.title}</strong>
					<small>Replace with Mathieu's selected artwork and crop.</small>
				</figcaption>
			</figure>
		))}
	</div>
</section>

<script>
	function setupLivingIndex() {
		const root = document.querySelector<HTMLElement>('[data-living-index]');
		if (!root || root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const triggers = Array.from(root.querySelectorAll<HTMLElement>('[data-stage-trigger]'));
		const frames = Array.from(root.querySelectorAll<HTMLElement>('[data-stage-frame]'));

		const activate = (id: string) => {
			if (!id || root.dataset.activeId === id) return;
			root.dataset.activeId = id;
			for (const trigger of triggers) {
				trigger.dataset.active = String(trigger.dataset.stageTrigger === id);
			}
			for (const frame of frames) {
				const active = frame.dataset.stageFrame === id;
				frame.dataset.active = String(active);
				frame.setAttribute('aria-hidden', String(!active));
			}
		};

		for (const trigger of triggers) {
			const id = trigger.dataset.stageTrigger;
			if (!id) continue;
			trigger.addEventListener('pointerenter', () => activate(id));
			trigger.addEventListener('focus', () => activate(id));
		}

		const narrow = window.matchMedia('(max-width: 760px)');
		if (narrow.matches && 'IntersectionObserver' in window) {
			const stage = root.querySelector<HTMLElement>('.art-stage');
			const inView = new Set<HTMLElement>();

			// Ranks by distance to the reading line, not intersectionRatio: ratio
			// lets short rows outscore taller ones permanently, so some entries
			// never became active during an ordinary scroll.
			const select = () => {
				const line = (stage?.getBoundingClientRect().bottom ?? 0) + 24;
				let best: HTMLElement | undefined;
				let bestDistance = Number.POSITIVE_INFINITY;
				for (const trigger of triggers) {
					if (!inView.has(trigger)) continue;
					const box = trigger.getBoundingClientRect();
					const distance = Math.abs(box.top + box.height / 2 - line);
					if (distance < bestDistance) {
						bestDistance = distance;
						best = trigger;
					}
				}
				const id = best?.dataset.stageTrigger;
				if (id) activate(id);
			};

			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						const target = entry.target as HTMLElement;
						if (entry.isIntersecting) inView.add(target);
						else inView.delete(target);
					}
					select();
				},
				{ rootMargin: '-42% 0px -14% 0px', threshold: [0, 0.35, 0.7, 1] },
			);
			for (const trigger of triggers) observer.observe(trigger);

			// Threshold crossings alone leave the choice stale between rows; a throttled
			// scroll pass keeps the reading line authoritative.
			let queued = false;
			window.addEventListener(
				'scroll',
				() => {
					if (queued) return;
					queued = true;
					requestAnimationFrame(() => {
						queued = false;
						select();
					});
				},
				{ passive: true },
			);
		}
	}

	setupLivingIndex();
	document.addEventListener('astro:page-load', setupLivingIndex);
</script>
