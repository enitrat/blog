---
/**
 * RoomTile: the living room as one tile on the bench.
 * The poster first; on a desktop the live scene takes over inside the tile
 * (LivingRoom reparents its stage into `[data-room-slot]`). Its objects glow, light
 * on hover and focus, and a click opens the room large at that object. A phone
 * loads the scene only after a tap. Without JS or WebGL, the tile is the poster
 * plus plain links.
 */
import { Picture } from 'astro:assets';
import poster from '../../assets/living-room.png';
import Button from '../ui/Button.astro';
import Equalizer from '../ui/Equalizer.astro';
import Icon from '../ui/Icon.astro';
import Label from '../ui/Label.astro';
import Magnetic from '../ui/Magnetic.astro';
import Pill from '../ui/Pill.astro';
import Tile from '../ui/Tile.astro';
import LivingRoom from './LivingRoom.astro';
---

<Tile
	variant="media"
	aria-label="The room"
	class="room-tile"
	span={{ md: 6, lg: 7 }}
	rows={{ lg: 4 }}
	order={1}
	data-room-tile
>
	<div slot="action" class="room-tile__actions">
		<span class="room-tile__playing" role="status"><Label><Equalizer />Now playing</Label></span>
		<Magnetic strength={0.2}>
			<Button variant="ghost" size="sm" type="button" data-room-open>
				Open <Icon name="arrow-right" size="sm" />
			</Button>
		</Magnetic>
	</div>
	<div class="room-tile__frame">
		<div class="room-tile__art" data-room-slot>
			<Picture
				class="room-tile__poster"
				src={poster}
				alt="A miniature living room: Pléiade books and records, a walnut hi-fi with a turntable, a pleated floor lamp, a patterned rug, and an oak writing desk with manuscripts under a green banker's lamp."
				widths={[640, 960, 1440]}
				sizes="(max-width: 64rem) 100vw, 44rem"
				formats={['avif']}
				fallbackFormat="webp"
				loading="eager"
				fetchpriority="high"
				decoding="sync"
			/>
			<div class="room-tile__lamp"></div>
		</div>
	</div>
	<nav class="room-tile__links" aria-label="The room, as links">
		<Pill href="/reading/">Reading</Pill>
		<Pill href="/writing/">Writing</Pill>
		<Pill href="https://soundcloud.com/user2211512/bouncyx-seven">The set on SoundCloud</Pill>
	</nav>
</Tile>
<LivingRoom />
