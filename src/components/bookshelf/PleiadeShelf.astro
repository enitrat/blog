---
import type { Book } from '../../booksData';
import { type PageRange, pleiadeStyleFor, spineWidthFor } from '../../utils/pleiade';
import PleiadeSpine from './PleiadeSpine.astro';

interface Props {
	shelfBooks: Book[];
	label: string;
	href?: string;
	size?: 'showcase' | 'extended';
	pageRange: PageRange;
}

const { shelfBooks, label, href, size = 'showcase', pageRange } = Astro.props;

const tilts = [
	...Array(3).fill(-0.16),
	...Array(5).fill(0.12),
	...Array(3).fill(-0.08),
	...Array(5).fill(0.18),
];
---


<div class="pleiade-shelf__viewport" role="region" aria-label={label}>
	<div class:list={['pleiade-shelf', `pleiade-shelf--${size}`]}>
		{shelfBooks.map((book, index) => {
			const style = pleiadeStyleFor(book.author);
			return (
				<PleiadeSpine
					title={book.title.replace(/\s*\(.*/, '')}
					author={style.label}
					color={style.color}
					pageCount={book.edition.pageCount}
					width={spineWidthFor(book.edition.pageCount, pageRange, size)}
					size={size}
					tilt={tilts[index % tilts.length]}
					href={book.writingSlug ? `/writing/${book.writingSlug}/` : href}
				/>
			);
		})}
	</div>
</div>

<style>
	.pleiade-shelf__viewport {
		margin-top: 1.5rem;
		padding: 12px 8px 0;
		outline-offset: 4px;
	}

	.pleiade-shelf {
		--shelf-book-height: 270px;
		--shelf-row-gap: 1.25rem;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		column-gap: 0;
		row-gap: var(--shelf-row-gap);
		width: 100%;
		min-width: 0;
		margin-inline: auto;
		padding: 18px 10px 10px;
		background-image:
			linear-gradient(var(--home-paper) 0 18px, transparent 18px),
			linear-gradient(
				to bottom,
				transparent 0 var(--shelf-book-height),
				var(--home-ink) var(--shelf-book-height) calc(var(--shelf-book-height) + 8px),
				transparent calc(var(--shelf-book-height) + 8px)
			);
		background-position: 0 0, 0 18px;
		background-size: 100% 100%, 100% calc(var(--shelf-book-height) + var(--shelf-row-gap));
		background-repeat: no-repeat, repeat-y;
	}

	.pleiade-shelf--extended {
		--shelf-book-height: 330px;
	}

	@media (max-width: 720px) {
		.pleiade-shelf__viewport {
			margin-inline: -1rem;
			padding-inline: 1rem;
		}

		.pleiade-shelf { padding-inline: 6px; }
	}
</style>
