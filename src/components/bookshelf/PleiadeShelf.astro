---
import type { Book } from '../../booksData';
import { type PageRange, pleiadeStyleFor, spineWidthFor } from '../../utils/pleiade';
import PleiadeSpine from './PleiadeSpine.astro';

interface Props {
	shelfBooks: Book[];
	label: string;
	href?: string;
	size?: 'showcase' | 'extended';
	pageRange: PageRange;
	booksPerLevel?: number;
}

const { shelfBooks, label, href, size = 'showcase', pageRange, booksPerLevel = 10 } = Astro.props;

const levels = Array.from({ length: Math.ceil(shelfBooks.length / booksPerLevel) }, (_, level) =>
	shelfBooks.slice(level * booksPerLevel, (level + 1) * booksPerLevel),
);

const tilts = [
	...Array(3).fill(-0.16),
	...Array(5).fill(0.12),
	...Array(3).fill(-0.08),
	...Array(5).fill(0.18),
];
---


<div class="pleiade-shelf__viewport" role="region" aria-label={label}>
	<div class="pleiade-shelf__levels">
		{levels.map((level, levelIndex) => (
			<div class:list={['pleiade-shelf', { 'pleiade-shelf--compact': level.length < 6 }]}>
				{level.map((book, index) => {
					const style = pleiadeStyleFor(book.author);
					const bookIndex = levelIndex * booksPerLevel + index;
					return (
						<PleiadeSpine
							title={book.title.replace(/\s*\(.*/, '')}
							author={style.label}
							color={style.color}
							pageCount={book.edition.pageCount}
							width={spineWidthFor(book.edition.pageCount, pageRange, size)}
							size={size}
							tilt={tilts[bookIndex % tilts.length]}
							href={book.writingSlug ? `/writing/${book.writingSlug}/` : href}
						/>
					);
				})}
			</div>
		))}
	</div>
</div>

<style>
	.pleiade-shelf__viewport {
		margin-top: 1.5rem;
		padding: 12px 8px 0;
		outline-offset: 4px;
	}

	.pleiade-shelf__levels {
		display: grid;
		gap: 1.25rem;
	}

	.pleiade-shelf {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1px;
		width: 100%;
		min-width: 0;
		margin-inline: auto;
		padding: 18px 10px 10px;
		border-bottom: 8px solid var(--home-ink);
	}

	.pleiade-shelf--compact {
		justify-content: center;
	}

	@media (max-width: 720px) {
		.pleiade-shelf__viewport {
			margin-inline: -1rem;
			padding-inline: 1rem;
		}

		.pleiade-shelf { padding-inline: 6px; }
	}
</style>
