---
/**
 * Fan: a stack of objects (`FanItem`) that spreads open while its host is hovered or has focus
 *   inside. Item 0 is in front; later items sit behind. Hover motion only under `(hover: hover)`.
 * @prop host "self" | "ancestor" (default "self"): "self" opens on the Fan's own hover/focus;
 *   "ancestor" on the nearest ancestor carrying `data-fan-host` (e.g. a `Tile`)
 * @prop class Extra class
 * @slot default `FanItem`s
 * @cssprop --fan-w Width of the stack (default 100%); each item fills it. Height follows the
 *   items' aspect ratio, so size a Fan by its width (on the Fan itself or a wrapper).
 */
interface Props {
	host?: 'self' | 'ancestor';
	class?: string;
}
const { host = 'self', class: cls } = Astro.props;
---

<div class:list={['fan', cls]} data-fan-host={host === 'self' ? '' : undefined}>
	<slot />
</div>

<style>
	.fan {
		position: relative;
		width: var(--fan-w, 100%);
	}
</style>
