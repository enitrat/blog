---
/**
 * FanItem: one object in a `Fan`. Transform is translate(x, y) rotate(r) scale(s) from the pose
 *   in force: rest, open (host hovered or focused within), or touch (`(hover: none)`).
 *   While the host is open, the item under the pointer (or holding focus) comes to the top, straightens
 *   (rotation x 0.3), grows to 1.04, lifts 4px and keeps `--elevation-object-lift`; its siblings
 *   recede (scale 0.98, slightly dimmed but opaque, plain `--elevation-object`). No stagger on this switch. Under
 *   reduced motion only the z-index raise and the shadow change remain.
 *   The first item is in normal flow and gives the Fan its size; later items stack behind it.
 * @prop i Stack index, 0 = front
 * @prop rest Pose at rest: `{ x?, y?, r? (deg), s? }`
 * @prop open Pose while the host is open
 * @prop touch Pose when hover is unavailable (default: rest)
 * @slot default A `Plate`, a link, anything
 */
import { type Pose, poseVars } from './fan.ts';

interface Props {
	i: number;
	rest?: Pose;
	open?: Pose;
	touch?: Pose;
}
const { i, rest = {}, open = rest, touch = rest } = Astro.props;
const style = `--i:${i};${poseVars('rest', rest)};${poseVars('open', open)};${poseVars('touch', touch)}`;
---

<div class="fan-item" data-front={i === 0 ? '' : undefined} style={style}>
	<slot />
</div>

<style>
	.fan-item {
		--x: var(--rest-x); --y: var(--rest-y); --r: var(--rest-r); --s: var(--rest-s);
		position: absolute;
		inset: 0;
		z-index: calc(100 - var(--i));
		transform: translate(var(--x), var(--y)) rotate(var(--r)) scale(var(--s));
		transform-origin: 50% 90%;
		transition:
		transform var(--duration-base) var(--ease-out),
		filter var(--duration-base) var(--ease-out);
	}
	.fan-item[data-front] {
		position: relative;
		inset: auto;
	}
	@media (hover: none) {
		.fan-item {
			--x: var(--touch-x); --y: var(--touch-y); --r: var(--touch-r); --s: var(--touch-s);
		}
	}
	@media (hover: hover) {
		.fan-item {
			--plate-glow-strength: 0.35;
		}
		:global([data-fan-host]:is(:hover, :focus-within)) .fan-item {
			--x: var(--open-x); --y: var(--open-y); --r: var(--open-r); --s: var(--open-s);
			--plate-shadow: var(--elevation-object-lift);
			--plate-glow-strength: 0.6;
			transition-duration: var(--duration-moderate);
			transition-timing-function: var(--ease-spring);
			transition-delay: calc(var(--i) * 40ms);
		}
	}
	@media (hover: hover) {
		/* the item under the pointer or holding focus rises at once (z-index never transitions) */
		.fan-item:is(:hover, :focus-within) {
			z-index: 101;
		}
		:global([data-fan-host]:has(.fan-item:is(:hover, :focus-within))) .fan-item:not(:is(:hover, :focus-within)) {
			--plate-shadow: var(--elevation-object);
			--plate-glow-strength: 0.35;
		}
	}
	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		:global([data-fan-host]:is(:hover, :focus-within)) .fan-item:is(:hover, :focus-within) {
			--r: calc(var(--open-r) * 0.3);
			--s: calc(var(--open-s) * 1.04);
			--y: calc(var(--open-y) - 4px);
			transition-duration: var(--duration-base);
			transition-timing-function: var(--ease-out);
			transition-delay: 0s;
		}
		:global([data-fan-host]:has(.fan-item:is(:hover, :focus-within))) .fan-item:not(:is(:hover, :focus-within)) {
			--s: calc(var(--open-s) * 0.98);
			/* stays opaque: a see-through card lets the one behind it bleed into its text */
			filter: brightness(0.96) saturate(0.85);
			transition:
				transform var(--duration-base) var(--ease-out),
				filter var(--duration-base) var(--ease-out);
			transition-delay: 0s;
		}
	}
	@media (hover: hover) and (prefers-reduced-motion: reduce) {
		:global([data-fan-host]:is(:hover, :focus-within)) .fan-item {
			--x: var(--rest-x); --y: var(--rest-y); --r: var(--rest-r); --s: var(--rest-s);
		}
	}
</style>
