---
/**
 * Pill: small mono capsule.
 * @prop variant "link" | "chip" | "toggle" (default "link")
 *   link: filled `--foreground` <a> (flips on dark surfaces) (needs href). chip: outlined, static or <a> with href.
 *   toggle: outlined <button> with aria-pressed; accent fill when pressed.
 * @prop href Renders an <a> (link, chip)
 * @prop pressed Toggle state (toggle only)
 * @slot default Pill text
 */
interface Props extends Omit<astroHTML.JSX.ButtonHTMLAttributes, 'type'> {
	variant?: 'link' | 'chip' | 'toggle';
	href?: string;
	pressed?: boolean;
}
const { variant = 'link', href, pressed = false, class: cls, ...rest } = Astro.props;
const common = {
	class: ['pill', cls].filter(Boolean).join(' '),
	'data-variant': variant,
};
const Tag = href ? 'a' : variant === 'toggle' ? 'button' : 'span';
---

{
	Tag === 'a' ? (
		<a {...common} {...rest} href={href}><slot /></a>
	) : Tag === 'button' ? (
		<button {...common} {...rest} type="button" aria-pressed={String(pressed)}><slot /></button>
	) : (
		<span {...common} {...rest}><slot /></span>
	)
}

<style>
	.pill {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: var(--control-height-sm);
		padding: 0 0.75rem;
		border: 0;
		border-radius: var(--radius-pill);
		font-family: var(--font-code);
		font-size: var(--text-label);
		font-weight: var(--weight-ui);
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		background: var(--pill-bg, transparent);
		color: var(--pill-fg, var(--foreground));
		box-shadow: inset 0 0 0 1px var(--pill-edge, transparent);
		transition:
			background var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out),
			box-shadow var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}
	a.pill:active,
	button.pill:active {
		transform: scale(var(--press-scale-control));
	}
	a.pill,
	button.pill {
		cursor: pointer;
	}
	a.pill::after,
	button.pill::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: max(100%, var(--target-min));
		height: max(100%, var(--target-min));
		transform: translate(-50%, -50%);
	}

	.pill[data-variant="link"] {
		--pill-bg: var(--foreground);
		--pill-fg: var(--surface);
	}
	.pill[data-variant="link"]:hover {
		--pill-bg: var(--accent);
		--pill-fg: var(--accent-foreground);
	}

	.pill[data-variant="chip"],
	.pill[data-variant="toggle"] {
		--pill-edge: var(--border);
	}
	a.pill[data-variant="chip"]:hover,
	.pill[data-variant="toggle"]:hover {
		--pill-edge: currentColor;
	}
	.pill[data-variant="toggle"][aria-pressed="true"] {
		--pill-bg: var(--accent);
		--pill-fg: var(--accent-foreground);
		--pill-edge: transparent;
	}

	.pill:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}
	@media (prefers-reduced-motion: reduce) {
		.pill { transition: none; }
		a.pill:active,
		button.pill:active { transform: none; }
	}
</style>
