---
// Sizing and stroke come from the surrounding context (`.site svg` and each
// surface's own rules), so this owns nothing but the glyph.
interface Props {
	direction?: 'right' | 'left';
}

const { direction = 'right' } = Astro.props;
const paths = {
	right: 'M5 12h13M13 6l6 6-6 6',
	left: 'M19 12H6M11 18l-6-6 6-6',
};
---

<svg viewBox="0 0 24 24" aria-hidden="true"><path d={paths[direction]} /></svg>
