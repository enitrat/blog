---
/**
 * CopyCodeButton: adds a ghost sm `Button` to every Shiki code block. Progressive
 * enhancement: without JS the code is still selectable and copyable by hand.
 */
import Button from '../ui/Button.astro';
---

<template id="copy-code-tpl"><Button variant="ghost" size="sm" class="copy-btn">Copy</Button></template>

<script>
	function initCopyButtons() {
		// One counter per language, so every block on the page has a name that
		// tells the reader which sample they are on rather than repeating "Copy".
		const seen = new Map<string, number>();
		const tpl = document.getElementById('copy-code-tpl') as HTMLTemplateElement | null;
		if (!tpl) return;

		for (const block of document.querySelectorAll<HTMLElement>('.astro-code')) {
			if (block.querySelector('.copy-btn')) continue;

			const language = block.dataset.language;
			const kind = language && language !== 'plaintext' ? language : 'code';
			const ordinal = (seen.get(kind) ?? 0) + 1;
			seen.set(kind, ordinal);
			const name = `${kind} sample ${ordinal}`;

			block.setAttribute('role', 'region');
			block.setAttribute('aria-label', name);

			// A scroll container is only reachable by keyboard if it is focusable,
			// but a block with nothing to scroll would be a tab stop that does
			// nothing — so the stop is added only while the code overflows.
			const syncFocusable = () => {
				if (block.scrollWidth > block.clientWidth) block.setAttribute('tabindex', '0');
				else block.removeAttribute('tabindex');
			};
			syncFocusable();
			if ('ResizeObserver' in window) new ResizeObserver(syncFocusable).observe(block);

			// The visible word starts the accessible name, so the spoken name and
			// the printed label still match.
			const button = tpl.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
			button.setAttribute('aria-label', `Copy ${name}`);

			const status = document.createElement('span');
			status.className = 'sr-only';
			status.setAttribute('role', 'status');

			button.addEventListener('click', async () => {
				const text = block.querySelector('code')?.textContent ?? '';
				try {
					await navigator.clipboard.writeText(text);
					button.textContent = 'Copied!';
					button.dataset.copied = '';
					status.textContent = 'Copied to clipboard';
				} catch {
					button.textContent = 'Failed';
					status.textContent = 'Copy failed';
				}
				setTimeout(() => {
					button.textContent = 'Copy';
					delete button.dataset.copied;
					status.textContent = '';
				}, 2000);
			});

			block.appendChild(button);
			block.appendChild(status);
		}
	}

	initCopyButtons();
	document.addEventListener('astro:page-load', initCopyButtons);
</script>

<style is:global>
	.astro-code {
		position: relative;
	}
	.astro-code .copy-btn {
		position: absolute;
		inset: var(--space-2) var(--space-2) auto auto;
		background: var(--surface);
	}
	.astro-code .copy-btn[data-copied] {
		color: var(--foreground);
	}
	.astro-code .sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
