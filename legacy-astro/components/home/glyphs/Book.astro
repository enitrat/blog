---
/** Book: a closed hardback lying flat; the spine faces left. The top board lifts a hair on hover. */
import IsoGlyph from '../../ui/IsoGlyph.astro';
import { box, pts } from '../../ui/iso';

interface Props {
	size?: number;
}
const { size } = Astro.props;
const foot = box(-15, -11, 15, 11, 0, 1.2);
const pages = box(-14, -10, 14, 10.4, 1.2, 5.8);
const spine = box(-15, 10.4, 15, 11, 0, 7);
const cover = box(-15, -11, 15, 11, 5.8, 7);
const sheets = [2.2, 3.4, 4.6].map((z) => pts([14, 10.4, z], [14, -10, z]));
const band = [-9, 9].map((x) => pts([x, 11, 1.4], [x, 11, 5.6]));
const title = [pts([-9, -3, 7], [5, -3, 7]), pts([-9, -0.4, 7], [-1, -0.4, 7])];
const frame = pts(
	[-12.5, -8.5, 7],
	[12.5, -8.5, 7],
	[12.5, 8.5, 7],
	[-12.5, 8.5, 7],
	[-12.5, -8.5, 7],
);
---

<IsoGlyph size={size} frame={[0, -3.9, 43]}>
	<polygon class="l" points={foot.left} />
	<polygon class="r" points={foot.right} />
	<polygon class="r" points={pages.right} />
	<polygon class="t" points={pages.top} />
	{sheets.map((s) => <polyline class="hair" points={s} />)}
	<polygon class="l" points={spine.left} />
	<polygon class="r" points={spine.right} />
	{band.map((b) => <polyline class="hair" points={b} />)}
	<g class="iso-part" style="--pose: translate(0, -1.6px)">
		<polygon class="l" points={cover.left} />
		<polygon class="r" points={cover.right} />
		<polygon class="t" points={cover.top} />
		<polyline class="hair" points={frame} />
		{title.map((t) => <polyline points={t} />)}
	</g>
</IsoGlyph>

<style>
	.hair {
		fill: none;
		opacity: 0.5;
	}
</style>
