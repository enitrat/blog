---
/** Footer: contact links, built from atoms. */
import { CONTACT_LINKS } from '../../consts';
import Link from '../ui/Link.astro';
---

<footer class="footer">
	<nav aria-label="Contact">
		{CONTACT_LINKS.map((c) => <Link variant="quiet" href={c.href} rel="me noreferrer" target="_blank">{c.label}</Link>)}
	</nav>
</footer>

<style>
	.footer {
		padding-block: var(--space-10) var(--space-8);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
	}
</style>
