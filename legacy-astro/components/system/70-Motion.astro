---
import Button from '../ui/Button.astro';
// Motion: pointer primitives. Tilt and Magnetic are live only with a hover pointer and no
// reduced-motion preference; Button and Pill sink on press everywhere.
import Glide from '../ui/Glide.astro';
import Label from '../ui/Label.astro';
import Magnetic from '../ui/Magnetic.astro';
import Pill from '../ui/Pill.astro';
import Plate from '../ui/Plate.astro';
import Readout from '../ui/Readout.astro';
import Tilt from '../ui/Tilt.astro';
---

<section class="motion" aria-labelledby="motion-h">
	<Label as="h2" id="motion-h">Motion</Label>

	<div class="group">
		<Label as="h3">Tilt</Label>
		<div class="row">
			<figure>
				<div class="obj"><Tilt><Plate ratio="1/1" radius="md"><div class="face">7.5°</div></Plate></Tilt></div>
				<figcaption>default max, with glare</figcaption>
			</figure>
			<figure>
				<div class="obj"><Tilt max={14} glare={false}><Plate ratio="1/1" radius="md"><div class="face">14°</div></Plate></Tilt></div>
				<figcaption>max=14, glare={'{false}'}</figcaption>
			</figure>
		</div>
	</div>

	<div class="group">
		<Label as="h3">Magnetic</Label>
		<div class="row">
			<figure>
				<Magnetic><Button>Strength 0.35</Button></Magnetic>
				<figcaption>default</figcaption>
			</figure>
			<figure>
				<Magnetic strength={0.2}><Pill href="#motion-h">Strength 0.2</Pill></Magnetic>
				<figcaption>low, for small targets</figcaption>
			</figure>
		</div>
	</div>

	<div class="group">
		<Label as="h3">Glide</Label>
		<div class="row">
			<figure>
				<Glide as="nav" shape="pill" class="demo-pill" aria-label="Glide pill demo">
					<a href="#motion-h" data-glide-item>Writing</a>
					<a href="#motion-h" data-glide-item>Reading</a>
					<a href="#motion-h" data-glide-item>About</a>
				</Glide>
				<figcaption>shape="pill": one highlight glides between items</figcaption>
			</figure>
			<figure>
				<Glide shape="row" class="demo-rows">
					<a href="#motion-h" data-glide-item>First row</a>
					<a href="#motion-h" data-glide-item>Second row</a>
					<a href="#motion-h" data-glide-item>Third row</a>
				</Glide>
				<figcaption>shape="row": bleeds sideways, rounded</figcaption>
			</figure>
		</div>
	</div>

	<div class="group">
		<Label as="h3">Readout</Label>
		<div class="row">
			<figure>
				<Readout id="demo-clock" mode="char" value="0:59" class="clock" />
				<figcaption>mode="char": only the characters that change roll, aligned from the right</figcaption>
			</figure>
			<figure>
				<Readout id="demo-title" value="East of Eden" class="title" />
				<figcaption>mode="text" (default): the whole string rolls, one line, truncated</figcaption>
			</figure>
			<figure>
				<Button variant="ghost" type="button" data-readout-demo>Change both</Button>
				<figcaption>setReadout(el, text); rapid presses retarget mid-roll, reduced motion crossfades</figcaption>
			</figure>
		</div>
	</div>

	<div class="group">
		<Label as="h3">Press</Label>
		<div class="row">
			<figure>
				<Button variant="ghost" type="button">Hold me</Button>
				<figcaption>Button, Pill: scale(--press-scale-control) on :active</figcaption>
			</figure>
			<figure>
				<Pill variant="toggle" pressed={false}>Toggle</Pill>
				<figcaption>no movement under reduced motion</figcaption>
			</figure>
		</div>
	</div>

	<div class="group">
		<Label as="h3">Record</Label>
		<figure>
			<figcaption>
				The Set tile's record has inertia: speed (deg/s) eases on SPRING_RECORD, a frame loop integrates it.
				Play spins up from the current angle, pause coasts to rest and stays there. Reduced motion: round, no spin.
			</figcaption>
		</figure>
	</div>
</section>

<style>
	.motion {
		display: grid;
		gap: var(--space-10);
	}
	.group {
		display: grid;
		gap: var(--space-4);
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-8);
	}
	figure {
		margin: 0;
		display: grid;
		gap: var(--space-3);
		justify-items: start;
	}
	figcaption {
		font-family: var(--font-code);
		font-size: var(--text-label);
		color: var(--muted-foreground);
	}
	.obj {
		width: 9rem;
		--tilt-radius: var(--radius-md);
	}
	.demo-pill {
		display: flex;
		gap: var(--space-5);
		margin-inline: var(--space-3);
	}
	.demo-rows {
		display: grid;
		width: 14rem;
		margin-inline: var(--space-3);
	}
	.demo-pill a,
	.demo-rows a {
		color: var(--muted-foreground);
		text-decoration: none;
		padding-block: var(--space-2);
	}
	.demo-pill a:hover,
	.demo-rows a:hover {
		color: var(--foreground);
	}
	.group :global(.clock) {
		font-family: var(--font-code);
		font-size: var(--text-heading);
	}
	.group :global(.title) {
		width: 12rem;
		font-weight: var(--weight-title);
	}
	.face {
		display: grid;
		place-items: center;
		height: 100%;
		font-family: var(--font-code);
	}
</style>

<script>
	import { setReadout } from '../ui/readout';

	const titles = ['East of Eden', 'The Changing World Order', 'Antifragile'];
	let n = 0;
	document.querySelector('[data-readout-demo]')?.addEventListener('click', () => {
		n += 1;
		const m = 59 + n;
		setReadout(document.querySelector<HTMLElement>('#demo-clock')!, `${Math.floor(m / 60)}:${String(m % 60).padStart(2, '0')}`);
		setReadout(document.querySelector<HTMLElement>('#demo-title')!, titles[n % titles.length]);
	});
</script>
