---
import ListRow from '../../components/ui/ListRow.astro';
import ListRows from '../../components/ui/ListRows.astro';
import Page from '../../components/ui/Page.astro';
import PageTitle from '../../components/ui/PageTitle.astro';
import Shell from '../../layouts/Shell.astro';
import { getWritingIndex, postUrl } from '../../utils/writing';

const posts = await getWritingIndex();
const fmt = (d: Date) =>
	d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
---

<Shell
	title="Writing"
	description="I write about software, AI, Cairo, and what I learn while building with them."
>
	<Page>
		<PageTitle>Writing</PageTitle>
		<ListRows>
			{posts.map((post) => (
				<ListRow
					headingLevel="h2"
					href={postUrl(post)}
					date={fmt(post.data.pubDate)}
					datetime={post.data.pubDate.toISOString()}
					title={post.data.title}
					description={post.data.description}
				/>
			))}
		</ListRows>
		{posts.length === 0 && <p>No posts yet.</p>}
	</Page>
</Shell>
